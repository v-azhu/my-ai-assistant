# Which LLM backend to use: "openai", "anthropic", "groq", or "ollama".
# Only the settings for the provider you choose need to be filled in.
LLM_PROVIDER=openai

# Optional: local proxy for reaching OpenAI/Anthropic/Groq on networks
# where those domains need one (e.g. v2ray/Clash). Point this at your
# proxy client's local SOCKS/HTTP port (check its settings — the port
# can change). Leave blank if your network reaches these APIs directly.
# Never affects local Ollama calls (see NO_PROXY handling in config.py).
HTTPS_PROXY=http://127.0.0.1:10809
HTTP_PROXY=http://127.0.0.1:10809

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq (used when LLM_PROVIDER=groq) ---
# Free, no credit card needed. Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# openai/gpt-oss-120b: OpenAI's open-weight 120B model, hosted by Groq.
# Other options: openai/gpt-oss-20b (smaller/faster).
# Note: llama-3.3-70b-versatile was Groq's long-time default but is
# being deprecated — check https://console.groq.com/docs/models for
# the current list if this stops working.
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama / local models (used when LLM_PROVIDER=ollama) ---
# No API key needed. Requires Ollama (https://ollama.com) running
# locally and the model pulled first, e.g.: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Separate embedding model, used by the local Mem0 memory backend
# (chat models don't produce embeddings). Pull it with:
#   ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
# Model used internally by Mem0 to decide what's worth remembering
# each turn (an extra LLM call on top of your normal chat reply).
# Leave blank to reuse OLLAMA_MODEL, or set a small/fast model here
# to keep that overhead low, e.g.: ollama pull llama3.2:1b
OLLAMA_MEMORY_MODEL=llama3.2:1b

# --- Memory (Mem0) backend: "local" or "cloud" ---
# local: free, self-hosted, uses Ollama + a local Chroma vector store.
# cloud: uses Mem0 Platform, needs an API key from https://app.mem0.ai
MEMORY_BACKEND=local
MEM0_API_KEY=
MEM0_USER_ID=default_user
MEM0_VECTOR_STORE_PATH=./mem0_data
MEM0_COLLECTION_NAME=my_ai_assistant_memories

# --- Shared generation settings (apply to whichever provider is active) ---
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# --- Conversation / memory tuning ---
MAX_HISTORY_TURNS=10
MEMORY_TOP_K=3
